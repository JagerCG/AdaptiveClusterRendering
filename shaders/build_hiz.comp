#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(std430,set=1,binding=0) buffer Pyramid { float z[]; } pyramid;
layout(set=1,binding=1) uniform sampler2D cameraDepth;
layout(push_constant) uniform Params { uvec4 src; uvec4 dst; } p; // width, height, offset, copy from D32
void main() {
    uvec2 xy = gl_GlobalInvocationID.xy;
    if (any(greaterThanEqual(xy, p.dst.xy))) return;
    float farthest = 0.0;
    if (p.dst.w != 0u) {
        farthest = texelFetch(cameraDepth, ivec2(xy), 0).r;
    } else {
        for (uint y = 0; y < 2; ++y)
            for (uint x = 0; x < 2; ++x) {
                uvec2 q = xy * 2u + uvec2(x, y);
                if (all(lessThan(q, p.src.xy))) farthest = max(farthest, pyramid.z[p.src.z + q.y * p.src.x + q.x]);
            }
    }
    pyramid.z[p.dst.z + xy.y * p.dst.x + xy.x] = farthest;
}
