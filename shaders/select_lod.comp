#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) readonly buffer Scene { uint words[]; } scene;
layout(std430, set = 1, binding = 0) buffer Cut { uint words[]; } cut;
layout(std430, set = 1, binding = 1) writeonly buffer Work { uint firstIndex[]; } work;
layout(push_constant) uniform Parameters {
    vec4 cameraZ; // dot(vec4(position,1), cameraZ) is forward view depth
    float focalPixels, budget, nearPlane, padding;
    uint nodeWord, nodes, blocks, gridX;
    uint clusterCapacity, triangleCapacity, phase, eligibleNodes;
} p;
shared uvec2 sums[64];
uint node(uint id) { return p.nodeWord + 12u * id; }
uint scratch(uint id) { return 16u + 3u * id; }
uint blockOffset(uint block) { return scratch(p.nodes) + 2u * block; }

bool fits(uint id) {
    if (id >= p.eligibleNodes) return false;
    uint n = node(id);
    if (scene.words[n+11] == 0u) return true;
    if (p.budget == 0.0) return false;
    vec3 lo = vec3(uintBitsToFloat(scene.words[n]), uintBitsToFloat(scene.words[n+1]), uintBitsToFloat(scene.words[n+2]));
    vec3 hi = vec3(uintBitsToFloat(scene.words[n+4]), uintBitsToFloat(scene.words[n+5]), uintBitsToFloat(scene.words[n+6]));
    float nearest = dot(p.cameraZ.xyz, mix(hi, lo, greaterThanEqual(p.cameraZ.xyz, vec3(0)))) + p.cameraZ.w
                  - dot(abs(p.cameraZ.xyz), vec3(p.padding));
    return nearest > p.nearPlane && uintBitsToFloat(scene.words[n+3]) * p.focalPixels <= p.budget * nearest;
}

void main() {
    uint block = gl_WorkGroupID.x + p.gridX * gl_WorkGroupID.y;
    if (block >= p.blocks) return;
    uint lane = gl_LocalInvocationID.x, id = 64u * block + lane;
    if (p.phase == 0u) {
        uvec2 weight = uvec2(0);
        if (id < p.nodes) {
            uint n = node(id), parent = scene.words[n+7];
            // Error never decreases and the AABB never shrinks going toward a root.
            // This edge predicate selects exactly the first acceptable node on every root-to-leaf path.
            bool picked = fits(id) && (parent == 0xffffffffu || !fits(parent));
            cut.words[scratch(id)+2] = picked ? 1u : 0u;
            if (picked) {
                uint first = scene.words[n+8], count = scene.words[n+9], last = (first+count-1u)*12u;
                weight = uvec2(count, (scene.words[last+8] + scene.words[last+9] - scene.words[first*12u+8])/3u);
            }
        }
        sums[lane] = weight;
        barrier();
        for (uint step = 1u; step < 64u; step *= 2u) {
            uvec2 addend = lane >= step ? sums[lane-step] : uvec2(0);
            barrier();
            sums[lane] += addend;
            barrier();
        }
        if (id < p.nodes) {
            uvec2 offset = sums[lane] - weight;
            cut.words[scratch(id)] = offset.x; cut.words[scratch(id)+1] = offset.y;
        }
        if (lane == 63u) {
            cut.words[blockOffset(block)] = sums[lane].x; cut.words[blockOffset(block)+1] = sums[lane].y;
        }
    } else if (p.phase == 1u) {
        if (lane != 0u) return;
        uvec2 total = uvec2(0);
        for (uint i = 0; i < p.blocks; ++i) {
            uint b = blockOffset(i);
            uvec2 next = uvec2(cut.words[b], cut.words[b+1]);
            cut.words[b] = total.x; cut.words[b+1] = total.y;
            total += next;
        }
        cut.words[0] = total.x; cut.words[1] = total.y;
        cut.words[2] = uint(total.x > p.clusterCapacity || total.y > p.triangleCapacity);
        cut.words[3] = 0u;
        // Four independent VkDispatchIndirectCommands for n=1,2,4,8.
        for (uint i = 0u; i < 4u; ++i) {
            uint m = 1u << (i*2u), at = 4u + i*3u;
            cut.words[at] = (total.y/64u)*m + ((total.y%64u)*m+63u)/64u;
            cut.words[at+1] = cut.words[at+2] = 1u;
        }
    } else {
        if (id >= p.nodes || cut.words[2] != 0u || cut.words[scratch(id)+2] == 0u) return;
        uint n = node(id), first = scene.words[n+8], count = scene.words[n+9];
        uint slot = cut.words[scratch(id)] + cut.words[blockOffset(block)];
        uint tri = cut.words[scratch(id)+1] + cut.words[blockOffset(block)+1];
        for (uint c = first; c < first + count; ++c) {
            uint firstIndex = scene.words[12u*c+8], indexCount = scene.words[12u*c+9];
            // Each compact record contains the global ID followed by VkDrawIndexedIndirectCommand.
            uint at = blockOffset(p.blocks) + 6u * slot++;
            cut.words[at] = c; cut.words[at+1] = indexCount; cut.words[at+2] = 1u;
            cut.words[at+3] = firstIndex; cut.words[at+4] = cut.words[at+5] = 0u;
            for (uint j = 0; j < indexCount; j += 3u) work.firstIndex[tri++] = firstIndex+j;
        }
    }
}
