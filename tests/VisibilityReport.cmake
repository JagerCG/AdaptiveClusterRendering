cmake_minimum_required(VERSION 3.20)
# Compare the same camera and displaced mesh through the viewer's normal options.
set(view "${DIR}/visibility.acrview")
function(run_case name)
    set(report "${DIR}/visibility-${name}.json")
    execute_process(COMMAND "${VIEWER}" ${ARGN} --benchmark "${report}" --benchmark-warmup 1 --benchmark-samples 3 --verify-gpu
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 50)
    if(NOT rc EQUAL 0 OR "${out}${err}" MATCHES "Vulkan validation (error|warning)")
        message(FATAL_ERROR "Visibility run ${name} failed (${rc}) ${out}\n${err}")
    endif()
    file(READ "${report}" json)
    set(${name} "${json}" PARENT_SCOPE)
endfunction()
set(base --fixture occlusion --subdivision 2 --displacement 0.08 --shadows)
run_case(full ${base})
run_case(frustum ${base} --cull frustum)
run_case(hierarchy ${base} --cull hierarchy)
run_case(flat ${base} --cull hiz-flat --hiz-mip 2)
run_case(hiz ${base} --hiz-mip 3 --rejected-bounds --save-view "${view}")
run_case(replay --view-config "${view}")
file(READ "${view}" latest)
string(REPLACE "ACR_VIEW 3" "ACR_VIEW 2" v2 "${latest}")
string(REGEX REPLACE "shadow_cull [^\n]*\n" "" v2 "${v2}")
file(WRITE "${DIR}/visibility-v2.acrview" "${v2}")
run_case(previous --view-config "${DIR}/visibility-v2.acrview")
string(JSON previousMode GET "${previous}" labels culling)
string(JSON previousCasters GET "${previous}" counts shadow_caster_clusters)
string(JSON previousCull GET "${previous}" flags shadow_culling)
if(NOT previousMode STREQUAL "hiz" OR NOT previousCasters EQUAL 16 OR previousCull)
    message(FATAL_ERROR "V2 camera settings or legacy full-caster behavior changed")
endif()
string(REPLACE "ACR_VIEW 2" "ACR_VIEW 1" v1 "${v2}")
string(REGEX REPLACE "culling [^\n]*\n" "" v1 "${v1}")
file(WRITE "${DIR}/visibility-v1.acrview" "${v1}")
run_case(legacy --view-config "${DIR}/visibility-v1.acrview")
string(JSON oldDraw GET "${legacy}" counts drawn_triangles)
if(NOT oldDraw EQUAL 128)
    message(FATAL_ERROR "V1 preset did not retain its original full drawing")
endif()
string(JSON flatNodes GET "${flat}" counts hierarchy_nodes_tested)
string(JSON flatUsed GET "${flat}" flags hiz_used)
if(NOT flatNodes EQUAL 0 OR NOT flatUsed)
    message(FATAL_ERROR "Per-cluster Hi-Z unexpectedly used hierarchy traversal or skipped occlusion")
endif()
foreach(name full frustum hierarchy hiz flat replay)
    if(name STREQUAL "full")
        set(visible 16)
    elseif(name STREQUAL "frustum" OR name STREQUAL "hierarchy")
        set(visible 12)
    else()
        set(visible 8)
    endif()
    math(EXPR drawn "8 * ${visible}")
    foreach(key candidate_clusters selected_clusters drawn_triangles generated_triangles shadow_triangles)
        if(key STREQUAL "candidate_clusters")
            set(want 16)
        elseif(key STREQUAL "selected_clusters")
            set(want ${visible})
        elseif(key STREQUAL "shadow_triangles")
            set(want 128)
        else()
            set(want ${drawn})
        endif()
        string(JSON value GET "${${name}}" counts ${key})
        if(NOT value EQUAL want)
            message(FATAL_ERROR "${name} ${key} was ${value}, expected ${want}")
        endif()
    endforeach()
endforeach()
foreach(key selected_cluster_ids view_projection_column_major)
    string(JSON a GET "${hiz}" ${key})
    string(JSON b GET "${replay}" ${key})
    if(NOT a STREQUAL b)
        message(FATAL_ERROR "Saved view changed ${key}")
    endif()
endforeach()
foreach(flag hiz_used hiz_preview show_rejected_bounds)
    string(JSON enabled GET "${replay}" flags ${flag})
    if(NOT enabled)
        message(FATAL_ERROR "Missing restored setting ${flag}")
    endif()
endforeach()
string(JSON mip GET "${replay}" counts requested_hiz_mip)
string(JSON levels GET "${replay}" counts hiz_levels)
if(NOT mip EQUAL 3 OR NOT levels EQUAL 11)
    message(FATAL_ERROR "Invalid mip metadata")
endif()
string(JSON timestamps GET "${replay}" flags gpu_timestamps_supported)
foreach(metric cpu_visibility_and_wait gpu_cull gpu_hiz)
    if(metric MATCHES "^gpu_" AND NOT timestamps)
        continue()
    endif()
    string(JSON count GET "${replay}" summary_ms ${metric} count)
    if(NOT count EQUAL 3)
        message(FATAL_ERROR "Missing ${metric} samples")
    endif()
endforeach()
message(STATUS "Culling modes, independent Hi-Z, displaced geometry, shadow casters and saved view verified.")
