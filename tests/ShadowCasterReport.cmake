cmake_minimum_required(VERSION 3.20)
function(run_case name)
    set(path "${DIR}/shadow-caster-${name}.json")
    execute_process(COMMAND "${VIEWER}" ${ARGN} --verify-gpu --benchmark "${path}" --benchmark-warmup 1 --benchmark-samples 3
        RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 45)
    if(NOT rc EQUAL 0 OR "${out}${err}" MATCHES "Vulkan validation (warning|error)")
        message(FATAL_ERROR "${name} failed (${rc})\n${out}\n${err}")
    endif()
    file(READ "${path}" json)
    set(${name} "${json}" PARENT_SCOPE)
endfunction()
function(check_value name expected)
    string(JSON value GET "${${name}}" ${ARGN})
    if(NOT value STREQUAL expected)
        message(FATAL_ERROR "${name}: expected ${expected} at ${ARGN}, got ${value}")
    endif()
endfunction()
function(compare_field a b key)
    string(JSON lhs GET "${${a}}" ${key})
    string(JSON rhs GET "${${b}}" ${key})
    if(NOT lhs STREQUAL rhs)
        message(FATAL_ERROR "${key} differs for ${a} and ${b}")
    endif()
endfunction()

set(common --fixture shadow-casters --shadow-coverage 0.30 --subdivision 2 --displacement 0.08)
set(view "${DIR}/shadow-casters.acrview")
run_case(all ${common} --shadows --shadow-cull all)
run_case(culled ${common} --shadows --shadow-cull frustum --save-view "${view}")
run_case(replayed --view-config "${view}")
run_case(map ${common} --shadow-map --shadow-cull frustum)
run_case(disabled ${common} --shadow-cull frustum)
foreach(name all culled replayed)
    check_value(${name} 32 counts drawn_triangles)
    check_value(${name} 4 counts shadow_candidate_clusters)
endforeach()
check_value(all 32 counts shadow_triangles)
foreach(name culled replayed map)
    check_value(${name} 16 counts shadow_triangles)
    check_value(${name} 2 counts shadow_caster_clusters)
    check_value(${name} 2 counts shadow_frustum_rejected)
    check_value(${name} 0 shadow_cluster_ids 0)
    check_value(${name} 1 shadow_cluster_ids 1)
    check_value(${name} 3 summary_ms cpu_shadow_cull_and_wait count)
    string(JSON timed GET "${${name}}" flags gpu_timestamps_supported)
    if(timed)
        check_value(${name} 3 summary_ms gpu_shadow_cull count)
        check_value(${name} 3 summary_ms gpu_shadow count)
    endif()
endforeach()
check_value(culled 0 selected_cluster_ids 0)
check_value(culled 1 selected_cluster_ids 1)
check_value(culled 2 selected_cluster_ids 2)
check_value(culled 3 selected_cluster_ids 3)
check_value(disabled 0 counts shadow_triangles)
check_value(map 0 counts drawn_triangles)
foreach(name disabled all)
    string(JSON metric TYPE "${${name}}" summary_ms cpu_shadow_cull_and_wait)
    if(NOT metric STREQUAL "NULL")
        message(FATAL_ERROR "${name} charged an inactive light-culling stage")
    endif()
endforeach()
foreach(field selected_cluster_ids shadow_cluster_ids light_view_projection_column_major view_projection_column_major)
    compare_field(culled replayed ${field})
endforeach()
compare_field(all culled light_view_projection_column_major)

# Compare identical fixed inputs from OBJ and its ACR cache.
set(cache "${DIR}/shadow-combined-suzanne.acr")
execute_process(COMMAND "${VIEWER}" --preprocess "${ASSET}" "${cache}" RESULT_VARIABLE rc
                OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 45)
if(NOT rc EQUAL 0)
    message(FATAL_ERROR "ACR preprocessing failed: ${out}\n${err}")
endif()
set(combined --shadows --shadow-cull frustum --shadow-coverage 0.45 --subdivision 2 --displacement 0.08)
run_case(obj "${ASSET}" ${combined})
run_case(acr "${cache}" ${combined})
foreach(field selected_cluster_ids shadow_cluster_ids light_view_projection_column_major view_projection_column_major)
    compare_field(obj acr ${field})
endforeach()
foreach(key candidate_clusters selected_clusters drawn_triangles shadow_candidate_clusters shadow_caster_clusters shadow_triangles)
    string(JSON expected GET "${obj}" counts ${key})
    check_value(acr "${expected}" counts ${key})
endforeach()
check_value(acr 1 counts source_file_version)
check_value(acr ON flags shadow_culling)
string(JSON rejected GET "${acr}" counts shadow_frustum_rejected)
if(rejected LESS 1)
    message(FATAL_ERROR "The combined real-model run did not exercise light rejection")
endif()
message(STATUS "Shadow selection, replay, pass timings and combined OBJ/ACR pipeline verified.")
