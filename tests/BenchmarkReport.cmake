# Exercise the real renderer and independently parse its persisted report.
set(args --fixture grid --bounds --cluster-colors --verify-gpu
    --benchmark "${REPORT}" --benchmark-warmup 2 --benchmark-samples 5)
set(expected_ids 0 1 2 3)
set(expected_triangles 8)
set(generated ON)
if(MODE STREQUAL "shadows" OR MODE STREQUAL "shadow-map")
    list(APPEND args --subdivision 4 --displacement 0.25 --shadows)
    set(expected_triangles 128)
    if(MODE STREQUAL "shadow-map")
        list(APPEND args --shadow-map)
        set(expected_triangles 0)
    endif()
elseif(MODE STREQUAL "all")
    list(APPEND args --subdivision 8 --displacement 0.25 --heightmap "${HEIGHT}")
    set(expected_triangles 512)
elseif(MODE STREQUAL "partial")
    list(APPEND args --subdivision 4 --selection last-first --displacement 0.25)
    set(expected_ids 3 0)
    set(expected_triangles 64)
elseif(MODE STREQUAL "empty")
    list(APPEND args --subdivision 4 --selection empty)
    set(expected_ids)
    set(expected_triangles 0)
elseif(MODE STREQUAL "source")
    set(generated OFF)
else()
    message(FATAL_ERROR "Unknown mode")
endif()
execute_process(COMMAND "${VIEWER}" ${args} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE errors TIMEOUT 50)
file(WRITE "${REPORT}.log" "${output}\n${errors}")
if(NOT result EQUAL 0 OR "${output}${errors}" MATCHES "Vulkan validation (warning|error)")
    message(FATAL_ERROR "Benchmark process failed: ${result}\n${output}\n${errors}")
endif()
file(READ "${REPORT}" json)
foreach(pair "warmup_runs;2" "measured_runs;5" "completed_runs;7")
    list(GET pair 0 key)
    list(GET pair 1 expected)
    string(JSON actual GET "${json}" ${key})
    if(NOT actual EQUAL expected)
        message(FATAL_ERROR "Incorrect ${key}: ${actual}")
    endif()
endforeach()
string(JSON triangles GET "${json}" counts drawn_triangles)
if(NOT triangles EQUAL expected_triangles)
    message(FATAL_ERROR "Incorrect draw count: ${triangles}")
endif()
string(JSON config GET "${json}" labels build_config)
if(NOT config STREQUAL CONFIG)
    message(FATAL_ERROR "Incorrect build label: ${config} vs ${CONFIG}")
endif()
string(JSON ui GET "${json}" flags ui_rendered)
string(JSON gen GET "${json}" flags generated_geometry)
string(JSON readback_excluded GET "${json}" flags readback_excluded)
if(ui OR NOT gen STREQUAL generated OR NOT readback_excluded)
    message(FATAL_ERROR "Incorrect timing scope flags")
endif()
string(JSON id_count LENGTH "${json}" selected_cluster_ids)
list(LENGTH expected_ids expected_count)
if(NOT id_count EQUAL expected_count)
    message(FATAL_ERROR "Incorrect selection length")
endif()
if(id_count GREATER 0)
    math(EXPR end "${id_count} - 1")
    foreach(i RANGE 0 ${end})
        string(JSON id GET "${json}" selected_cluster_ids ${i})
        list(GET expected_ids ${i} expected)
        if(NOT id EQUAL expected)
            message(FATAL_ERROR "Lost source cluster ordering")
        endif()
    endforeach()
endif()
string(JSON timestamps GET "${json}" flags gpu_timestamps_supported)
set(previous 0)
foreach(i RANGE 0 4)
    string(JSON revision GET "${json}" samples ${i} generation_revision)
    if(generated)
        if(NOT revision GREATER previous OR revision LESS 4)
            message(FATAL_ERROR "Cached output or warmup leaked into samples")
        endif()
    elseif(NOT revision EQUAL 0)
        message(FATAL_ERROR "Source draw reported a generation")
    endif()
    set(previous ${revision})
    foreach(metric cpu_generate gpu_generate gpu_render gpu_main gpu_shadow)
        string(JSON type TYPE "${json}" samples ${i} ${metric}_ms)
        set(available ON)
        if(metric STREQUAL "cpu_generate" AND NOT generated)
            set(available OFF)
        elseif(metric STREQUAL "gpu_generate" AND (NOT generated OR NOT timestamps OR MODE STREQUAL "empty"))
            set(available OFF)
        elseif((metric STREQUAL "gpu_render" OR metric STREQUAL "gpu_main") AND NOT timestamps)
            set(available OFF)
        elseif(metric STREQUAL "gpu_shadow" AND (NOT timestamps OR NOT (MODE STREQUAL "shadows" OR MODE STREQUAL "shadow-map")))
            set(available OFF)
        endif()
        if(available)
            string(JSON value GET "${json}" samples ${i} ${metric}_ms)
            if(NOT type STREQUAL "NUMBER" OR value LESS 0)
                message(FATAL_ERROR "Missing/invalid ${metric}")
            endif()
        elseif(NOT type STREQUAL "NULL")
            message(FATAL_ERROR "Fabricated ${metric} for an unavailable operation")
        endif()
    endforeach()
endforeach()
message(STATUS "Benchmark ${MODE}: report, sample count, scope, selection, regeneration and timings verified.")

if(MODE STREQUAL "shadows" OR MODE STREQUAL "shadow-map")
    string(JSON caster_triangles GET "${json}" counts shadow_triangles)
    if(NOT caster_triangles EQUAL 128)
        message(FATAL_ERROR "Shadow pass did not draw the generated geometry")
    endif()
endif()
